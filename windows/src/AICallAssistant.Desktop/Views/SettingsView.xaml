<UserControl x:Class="AICallAssistant.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AICallAssistant.Core.Models;assembly=AICallAssistant.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30,24,30,32">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center">
                <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="OpenAI, распознавание речи и формат подсказок."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,6,0,22" />

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="OpenAI API key" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Хранится локально с защитой текущего пользователя Windows."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           FontSize="11" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CredentialStatusText}" FontSize="11" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox"
                                         PasswordChanged="ApiKeyBox_PasswordChanged"
                                         ToolTip="Введите API key — сохранённое значение никогда не отображается" />
                            <Button Grid.Column="1"
                                    Content="Сохранить"
                                    Command="{Binding SaveApiKeyCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinHeight="36"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="2"
                                    Content="Проверить"
                                    Command="{Binding TestApiKeyCommand}"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="3"
                                    Content="Удалить"
                                    Command="{Binding DeleteApiKeyCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding SettingsStatus}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="МОДЕЛИ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ответы и анализ" FontWeight="SemiBold" />
                                <TextBlock Text="Responses API" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding SettingsDraft.ResponsesModelId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,13" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live-транскрипция" FontWeight="SemiBold" />
                                <TextBlock Text="Realtime API" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding SettingsDraft.RealtimeTranscriptionModelId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,13" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Обработка записи" FontWeight="SemiBold" />
                                <TextBlock Text="После звонка" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding SettingsDraft.FileTranscriptionModelId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="РАСПОЗНАВАНИЕ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Языки разговора" FontWeight="SemiBold" />
                            <TextBlock Text="Можно выбрать оба языка."
                                       Style="{StaticResource SecondaryTextStyle}"
                                       FontSize="11"
                                       Margin="0,3,0,11" />
                            <CheckBox Content="Русский" IsChecked="{Binding IsRussianEnabled}" Margin="0,0,0,9" />
                            <CheckBox Content="English" IsChecked="{Binding IsEnglishEnabled}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="ПОДСКАЗКИ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Формат ответа" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ComboBox SelectedValue="{Binding SettingsDraft.AnswerStyle}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,13">
                                <ComboBoxItem Content="Кратко" Tag="{x:Static models:AnswerStyle.Brief}" />
                                <ComboBoxItem Content="Подробно" Tag="{x:Static models:AnswerStyle.Detailed}" />
                            </ComboBox>
                            <TextBlock Text="Язык ответа" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ComboBox SelectedValue="{Binding SettingsDraft.AnswerLanguage}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Как в вопросе" Tag="{x:Static models:AnswerLanguage.Automatic}" />
                                <ComboBoxItem Content="Русский" Tag="{x:Static models:AnswerLanguage.Russian}" />
                                <ComboBoxItem Content="English" Tag="{x:Static models:AnswerLanguage.English}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ЛИМИТЫ" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Краткий ответ" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="слов" Style="{StaticResource SecondaryTextStyle}" FontSize="10" Margin="0,2,0,6" />
                                <TextBox Text="{Binding SettingsDraft.BriefAnswerMaxWords, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Подробный" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="слов" Style="{StaticResource SecondaryTextStyle}" FontSize="10" Margin="0,2,0,6" />
                                <TextBox Text="{Binding SettingsDraft.DetailedAnswerMaxWords, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Совет" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="слов" Style="{StaticResource SecondaryTextStyle}" FontSize="10" Margin="0,2,0,6" />
                                <TextBox Text="{Binding SettingsDraft.AdviceMaxWords, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Вывод" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="токенов" Style="{StaticResource SecondaryTextStyle}" FontSize="10" Margin="0,2,0,6" />
                                <TextBox Text="{Binding SettingsDraft.MaxOutputTokens, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Изменения применятся к следующему звонку."
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Сохранить настройки"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="22,10" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
