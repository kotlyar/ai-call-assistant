<UserControl x:Class="AICallAssistant.Desktop.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AICallAssistant.Core.Models;assembly=AICallAssistant.Core"
             xmlns:vm="clr-namespace:AICallAssistant.Desktop.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="28,22,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Записи" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding RecordingCountText}" Style="{StaticResource SecondaryTextStyle}" Margin="10,8,0,0" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     Text="{Binding RecordingSearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по названию и транскрипту" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}">
                <DockPanel Margin="8,12">
                    <TextBlock DockPanel.Dock="Top" Text="ВСЕ ЗВОНКИ" Style="{StaticResource SectionTitleStyle}" Margin="10,0,0,10" />
                    <ListBox ItemsSource="{Binding FilteredRecordings}"
                             SelectedItem="{Binding SelectedRecording, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                                        <Border Grid.Column="1">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                                                            <Setter Property="Background" Value="#17382E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                                                            <Setter Property="Background" Value="#3A2C18" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                                                            <Setter Property="Background" Value="#3A1D25" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22" MaxWidth="760">
                    <TextBlock Text="{Binding SelectedRecording.Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRecording.MetadataText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,18" />

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Width="38"
                                        Height="38"
                                        Padding="0"
                                        Command="{Binding TogglePlaybackCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                    <TextBlock Text="{Binding PlaybackGlyph}" FontFamily="Segoe Fluent Icons" FontSize="15" />
                                </Button>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Общий звук" FontWeight="SemiBold" />
                                    <TextBlock Text="Собеседник + ваш микрофон" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding PlaybackTimeText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>

                            <Slider Grid.Row="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding PlaybackProgress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,14,0,13"
                                    PreviewMouseLeftButtonUp="PlaybackSlider_MouseLeftButtonUp" />

                            <WrapPanel Grid.Row="2">
                                <TextBlock Text="Экспорт:" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Общая"
                                        Command="{Binding RequestAudioExportCommand}"
                                        CommandParameter="{x:Static vm:AudioExportKind.Combined}"
                                        Style="{StaticResource TextButtonStyle}" />
                                <Button Content="Собеседник"
                                        Command="{Binding RequestAudioExportCommand}"
                                        CommandParameter="{x:Static vm:AudioExportKind.Incoming}"
                                        Style="{StaticResource TextButtonStyle}" />
                                <Button Content="Микрофон"
                                        Command="{Binding RequestAudioExportCommand}"
                                        CommandParameter="{x:Static vm:AudioExportKind.Outgoing}"
                                        Style="{StaticResource TextButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Транскрипт" Command="{Binding SelectRecordingTabCommand}" CommandParameter="Transcript" Margin="0,0,7,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecordingTab}" Value="Transcript">
                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="AI-анализ" Command="{Binding SelectRecordingTabCommand}" CommandParameter="Analysis" Margin="0,0,7,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecordingTab}" Value="Analysis">
                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Файлы" Command="{Binding SelectRecordingTabCommand}" CommandParameter="Files">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecordingTab}" Value="Files">
                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Grid>
                        <ItemsControl ItemsSource="{Binding SelectedRecordingTurns}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecordingTab}" Value="Transcript">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Вы" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.Participant}">
                                                                    <Setter Property="Text" Value="Собеседник" />
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Offset}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecordingTab}" Value="Analysis">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Итоговые вопросы и ответы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SelectedRecording.AnalysisSummary}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding SelectedAnalysisCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="ВОПРОС" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,13" />
                                                <TextBlock Text="ОТВЕТ" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,12" />
                                                <Border Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="8" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="Совет" FontWeight="SemiBold" FontSize="11" />
                                                        <TextBlock Text="{Binding Advice}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource SecondaryTextStyle}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRecordingTab}" Value="Files">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="transcript.txt" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedRecording.StatusText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Повторить"
                                                Command="{Binding RetryProcessingCommand}"
                                                Visibility="{Binding SelectedRecording.CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,0,7,0" />
                                        <Button Content="Открыть" Command="{Binding OpenTranscriptCommand}" Margin="0,0,7,0" />
                                        <Button Content="Папка" Command="{Binding RevealRecordingCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SelectedRecording.FolderName}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="4,10,0,0" />
                            <TextBlock Text="{Binding SelectedRecording.ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="4,8,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
