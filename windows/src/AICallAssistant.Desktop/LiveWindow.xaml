<Window x:Class="AICallAssistant.Desktop.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AICallAssistant.Core.Models;assembly=AICallAssistant.Core"
        Title="Callya — Live"
        Width="440"
        Height="740"
        MinWidth="370"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0D131D"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#F20D131D"
            BorderBrush="#46566D"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="#B8161F2C" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="LIVE" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CallElapsedText}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#xE921;"
                        FontFamily="Segoe Fluent Icons"
                        Style="{StaticResource TextButtonStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Click="Minimize_Click"
                        ToolTip="Свернуть" />
                <Button Grid.Column="2"
                        Content="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons"
                        Style="{StaticResource TextButtonStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Click="Close_Click"
                        ToolTip="Завершить звонок"
                        Margin="0,0,7,0" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,15,16,18">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="13" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Собеседник" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding IncomingLiveStatus}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Ваш микрофон" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OutgoingLiveStatus}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Margin="2,0,2,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GuidanceStatus}" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource AccentBrush}" />
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="7,3">
                            <TextBlock Text="{Binding SelectedContextText}" Foreground="{StaticResource AccentBrush}" FontSize="9" />
                        </Border>
                    </Grid>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrentGuidance}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentGuidanceLate}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ВОПРОС" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource AccentBrush}" />
                                <Border Grid.Column="1" Background="#3B2D18" CornerRadius="9" Padding="7,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentGuidanceLate}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="с опозданием" Foreground="{StaticResource WarningBrush}" FontSize="9" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LiveQuestionText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="21"
                                       Margin="0,7,0,16" />

                            <TextBlock Text="ОТВЕТ" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding LiveAnswerText}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="25"
                                       Margin="0,7,0,16" />

                            <Border Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="9" Padding="11">
                                <StackPanel>
                                    <TextBlock Text="Совет" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding LiveAdviceText}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding LiveEvidenceText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Margin="0,11,0,0" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrentGuidance}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Margin="4,18" HorizontalAlignment="Center">
                            <Grid Width="44" Height="44">
                                <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="3" />
                                <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeDashArray="2,5" />
                            </Grid>
                            <TextBlock Text="{Binding GuidancePlaceholderTitle}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding GuidancePlaceholderDetail}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="330" />
                        </StackPanel>
                    </Border>

                    <Expander IsExpanded="True" Margin="0,14,0,0">
                        <Expander.Header>
                            <Grid Width="380">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Последние реплики" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding LiveTranscriptCountText}" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
                            </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding LiveTranscriptTurns}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Вы" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Speaker}" Value="{x:Static models:TranscriptSpeaker.Participant}">
                                                                <Setter Property="Text" Value="Собеседник" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander IsExpanded="False" Margin="0,10,0,0">
                        <Expander.Header>
                            <Grid Width="380">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="История ответов" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding HistoryCountText}" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
                            </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding AnswerHistory}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Text="{Binding Answer}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#F2161F2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="13">
                <Button Content="Завершить звонок"
                        Command="{Binding EndCallCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalAlignment="Stretch" />
            </Border>
        </Grid>
    </Border>
</Window>
